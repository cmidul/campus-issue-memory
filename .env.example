# Copy this file to `.env` and fill in the values you need.
# Nothing here is required for the demo — the app runs with zero keys.

# ---------------------------------------------------------------- server ---
# Port the Express API listens on.
PORT=4000

# Only sign-ins from this university e-mail domain are accepted.
# Set this to your institution, e.g. EXAMPLE_UNIVERSITY.EDU
# (do not commit a real value; it stays local in .env)
UNIVERSITY_EMAIL_DOMAIN=

# Secret that signs the session cookie (any long random string).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, Google sign-in stays off and only the demo sign-in works.
SESSION_SECRET=

# Public base URL of this server; Google redirects back here.
# APP_BASE_URL=http://localhost:4000

# Comma-separated e-mails that receive the admin role.
# Everyone else on UNIVERSITY_EMAIL_DOMAIN signs in as a normal user.
# ADMIN_EMAILS=

# --------------------------------------------------------------- supabase --
# Supabase project (free tier). Settings → API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------- google oauth --
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------------------- ai -----
# Optional. OpenRouter free-tier key for the vision-language model.
# Without it the app falls back to demo behaviour (AI is never required).
OPENROUTER_API_KEY=
# Model used for photo/clip description suggestions (free tier).
OPENROUTER_MODEL=qwen/qwen2.5-vl-7b-instruct:free
